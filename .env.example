ADZUNA_APP_ID=YOUR_ADZUNA_APP_ID
ADZUNA_APP_KEY=YOUR_ADZUNA_APP_KEY
JOOBLE_API_KEY=YOUR_JOOBLE_API_KEY

# Database file location
DATABASE_PATH=jobs.db

# Adzuna country code (gb=UK, us=USA, au=Australia, etc.)
# NOTE: UAE is NOT supported by Adzuna. Use Jooble for UAE.
DEFAULT_COUNTRY=gb

# Default search keyword (comma-separated for multiple)
DEFAULT_WHAT=AI Engineer

# Default location for Jooble (Adzuna ignores this for UAE)
DEFAULT_WHERE=UAE

# Jobs per API page
RESULTS_PER_PAGE=20

# Auto-apply settings USER_PROFILE_PATH=config/user_profile.json
SCREENSHOTS_DIR=applications/screenshots
HEADLESS=true
AUTO_APPLY_LIMIT=50
